function deleteSubject(key){

  const index =
    SUBJECT_CATALOG.findIndex(
      subject =>
        subject.key === key
    );

  if(index === -1){
    return;
  }

  const deleted =
    SUBJECT_CATALOG[index];

  SUBJECT_CATALOG.splice(
    index,
    1
  );

  saveSubjects();

  selectedSubject = null;

  closeModal();

  toast(
    `${deleted.name} deleted.`
  );

  renderHome();
}


