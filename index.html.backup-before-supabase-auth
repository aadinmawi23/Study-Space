   ========================================================= */

function save(){
  localStorage.setItem(
    "floPerformance",
    JSON.stringify(performance)
  );

  localStorage.setItem(
    "floAnswerHistory",
    JSON.stringify(answerHistory)
  );
}

function toast(message){
  const t = document.getElementById("toast");

  t.textContent = message;
  t.style.display = "block";

  clearTimeout(window._toast);

  window._toast = setTimeout(()=>{
    t.style.display = "none";
  },2300);
}

function normalize(value){
  return String(value || "")
    .trim()
    .toLowerCase()
    .replace(/\s+/g," ");
}

function slugify(value){
  return normalize(value)
    .replace(/[^a-z0-9]+/g,"-")
    .replace(/^-+|-+$/g,"")
    .slice(0,60);
}

function escapeHTML(value){
  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}

function dateKey(date = new Date()){
  return date.toISOString().slice(0,10);
}

function addDays(days){
  const d = new Date();

  d.setDate(
    d.getDate() + days
  );

  return dateKey(d);
}


/* =========================================================
   QUESTION BANK HELPERS
   ========================================================= */

function allQuestions(){

  return banks.flatMap(bank =>
    bank.questions.map(question => ({
      ...question,

      subject:
        question.subject ||
        bank.subject,

      topic:
        question.topic ||
        bank.topic,

      source:
        question.source ||
        bank.source
    }))
  );
}

function getQuestion(id){
  return allQuestions()
    .find(question => question.id === id);
}

function getSubject(key){
  return SUBJECT_CATALOG
    .find(subject => subject.key === key);
}

function getQuestionsForSubject(subject){
  const questionSubject =
    subject.questionSubject || subject.name;

  return allQuestions()
    .filter(question =>
      normalize(question.subject) ===
      normalize(questionSubject)
    );
}

function getQuestionsForTopic(subject,topic){

  const questionSubject =
    subject.questionSubject || subject.name;

  return allQuestions()
    .filter(question =>
      normalize(question.subject) ===
      normalize(questionSubject) &&
      normalize(question.topic) ===
      normalize(topic)
    );
}


/* =========================================================
   PERFORMANCE
   ========================================================= */

function perf(id){

  if(!performance[id]){

    performance[id] = {
      attempts:0,
      correct:0,
      wrong:0,
      unknown:0,
      streak:0,
      mastery:0,
      lastAttempted:null,
      nextReview:null,
      interval:0
    };
  }

  return performance[id];
}

function calculateMastery(p){

  if(!p.attempts){
    return 0;
  }

  const accuracy =
    p.correct / p.attempts;

  const repetition =
    Math.min(1,p.streak / 5);

  return Math.round(
    (
      accuracy * 0.7 +
      repetition * 0.3
    ) * 100
  );
}

function recordAnswer(q,chosen,result){

  const p = perf(q.id);

  p.attempts++;

  if(result === "correct"){

    p.correct++;
    p.streak++;

    const intervals = {
      0:1,
      1:3,
      3:7,
      7:14,
      14:30,
      30:30
    };

    p.interval =
      intervals[p.interval] ?? 30;

    p.nextReview =
      addDays(p.interval);

  }else{

    if(result === "wrong"){
      p.wrong++;
    }

    if(result === "unknown"){
      p.unknown++;
    }

    p.streak = 0;
    p.interval = 0;
    p.nextReview = dateKey();
  }

  p.mastery =
    calculateMastery(p);

  p.lastAttempted =
    new Date().toISOString();

  answerHistory.push({
    questionId:q.id,
    timestamp:new Date().toISOString(),
    answer:chosen,
    correctAnswer:q.answer,
    result
  });

  save();

  /* Also persist to server.js */
  fetch("/api/performance/answer",{
    method:"POST",
    headers:{
      "Content-Type":"application/json"
    },
    body:JSON.stringify({
      questionId:q.id,
      answer:chosen,
      result,
      timestamp:p.lastAttempted
    })
  }).catch(error=>{
    console.warn(
      "Server performance sync failed:",
      error
    );
  });
}


/* =========================================================
   SUBJECT / TOPIC STATS
   ========================================================= */

function subjectStats(subject){

  const qs =
    getQuestionsForSubject(subject);

  const mastered =
    qs.reduce(
      (total,q) =>
        total + perf(q.id).mastery,
      0
    );

  return {
    questions:qs.length,

    mastery:
      qs.length
        ? Math.round(mastered / qs.length)
        : 0,

    answered:
      qs.filter(
        q => perf(q.id).attempts > 0
      ).length,

    due:
      qs.filter(
        q =>
          perf(q.id).nextReview &&
          perf(q.id).nextReview <= dateKey()
      ).length
  };
}

function topicStats(subject,topic){

  const qs =
    getQuestionsForTopic(subject,topic);

  const mastery =
    qs.length
      ? Math.round(
          qs.reduce(
            (total,q) =>
              total + perf(q.id).mastery,
            0
          ) / qs.length
        )
      : 0;

  return {
    questions:qs.length,
    mastery,

    due:
      qs.filter(
        q =>
          perf(q.id).nextReview &&
          perf(q.id).nextReview <= dateKey()
      ).length
  };
}


/* =========================================================
   LOAD QUESTION BANKS
   ========================================================= */

async function loadBanks(){

  try{

    const response =
      await fetch("/api/question-banks");

    const data =
      await response.json();

    banks =
      data.banks || [];

    if(data.errors?.length){
      console.warn(
        "Question bank errors:",
        data.errors
      );
    }

    render();

  }catch(error){

    banks = [];

    render();

    toast(
      "Could not load question banks. Check server.js."
    );
  }
}


/* =========================================================
   NAVIGATION
   ========================================================= */

function navigate(page){

  selectedSubject = null;
  currentQuiz = null;

  history.replaceState(
    {},
    "",
    `#${page}`
  );

  render(page);
}

function render(page){

  page =
    page ||
    location.hash.slice(1) ||
    "home";

  document
    .querySelectorAll("[data-page]")
    .forEach(button=>{
      button.classList.toggle(
        "active",
        button.dataset.page === page
      );
    });

  if(page === "home"){
    renderHome();
  }
  else if(page === "review"){
    renderReview();
  }
  else if(page === "calendar"){
    renderCalendar();
  }
  else if(page === "trophies"){
    renderTrophies();
  }
  else if(page === "progress"){
    renderProgress();
  }
  else if(page === "settings"){
    renderSettings();
  }
  else{
    renderHome();
  }
}


