/* =========================================================
   SOUND EFFECTS
   ========================================================= */

const appSounds = {
  click: new Audio("/sounds/click.mp3"),
  correct: new Audio("/sounds/correct.mp3"),
  wrong: new Audio("/sounds/wrong.mp3"),
  complete: new Audio("/sounds/complete.mp3"),
  trophy: new Audio("/sounds/trophy.mp3")
};

Object.values(appSounds).forEach(sound => {
  sound.preload = "auto";
});

function playAppSound(name){

  if(soundsMuted){
    return;
  }

  const sound =
    appSounds[name];

  if(!sound){
    return;
  }

  sound.currentTime = 0;

  sound.play().catch(()=>{});
}


/* =========================================================
   CLICK SOUND
   ========================================================= */

document.addEventListener(
  "click",
  event => {

    const target =
      event.target.closest(
        "button, a, [role='button']"
      );

    if(!target){
      return;
    }

    /*
     * Quiz answer buttons have their own
     * correct/wrong sounds, so don't give
     * them the generic click sound.
     */

    if(
      target.classList.contains("option") ||
      target.classList.contains("unknown")
    ){
      return;
    }

    playAppSound("click");

  }
);

const SOUND_MUTED_KEY = "floSoundsMuted";
let soundsMuted =
  localStorage.getItem(SOUND_MUTED_KEY) === "true";

function updateMuteButton(){
  const button = document.getElementById("muteSoundsButton");
  if(!button) return;

  button.classList.toggle("muted", soundsMuted);

  button.setAttribute(
    "aria-label",
    soundsMuted ? "Unmute sounds" : "Mute sounds"
  );

  button.setAttribute(
    "title",
    soundsMuted ? "Unmute sounds" : "Mute sounds"
  );

  if(typeof appSounds !== "undefined"){
    Object.values(appSounds).forEach(sound=>{
      sound.muted = soundsMuted;
    });
  }
}

function toggleSoundMute(event){
  if(event) event.stopPropagation();

  soundsMuted = !soundsMuted;

  localStorage.setItem(
    SOUND_MUTED_KEY,
    String(soundsMuted)
  );

  updateMuteButton();
}

document.addEventListener(
  "DOMContentLoaded",
  updateMuteButton
);

updateMuteButton();


</script>
