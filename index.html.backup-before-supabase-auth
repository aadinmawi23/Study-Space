/* =========================================================
   CALENDAR
   ========================================================= */

async function renderCalendar(){

  const now =
    calendarViewDate;

  const year =
    now.getFullYear();

  const month =
    now.getMonth();

  const first =
    new Date(
      year,
      month,
      1
    );

  const days =
    new Date(
      year,
      month + 1,
      0
    ).getDate();

  const start =
    first.getDay();

  let reviewData = {
    calendar: {}
  };

  try {

    const response =
      await fetch(
        "/api/review-calendar"
      );

    if(response.ok){
      reviewData =
        await response.json();
    }

  } catch(error){

    console.error(
      "Failed to load review calendar:",
      error
    );

  }

  const calendar =
    reviewData.calendar || {};

  const dueBy = {};

  Object.keys(calendar).forEach(date => {

    dueBy[date] =
      calendar[date] || [];

  });


  let cells = "";

  [
    "Sun",
    "Mon",
    "Tue",
    "Wed",
    "Thu",
    "Fri",
    "Sat"
  ].forEach(day=>{

    cells += `
      <div class="day-name">
        ${day}
      </div>
    `;

  });


  for(
    let i=0;
    i<start;
    i++
  ){

    cells += "<div></div>";

  }


  for(
    let day=1;
    day<=days;
    day++
  ){

    const key =
      `${year}-${String(month+1).padStart(2,"0")}-${String(day).padStart(2,"0")}`;

    const reviews =
      dueBy[key] || [];

    const topics = [
      ...new Map(
        reviews.map(item => [
          `${item.subject}|||${item.topic}`,
          item
        ])
      ).values()
    ];

    cells += `

      <div
        class="day ${
          key === dateKey()
            ? "today"
            : ""
        }"
        ${
          reviews.length
            ? `onclick='startQuizByIds(
                ${JSON.stringify(
                  reviews.map(item=>item.questionId)
                )}
              )'`
            : ""
        }
      >

        <div class="num">
          ${day}
        </div>

        ${
          topics.length
            ? `
              <div class="due">
                ${topics.length}
                ${topics.length === 1 ? "topic" : "topics"}
              </div>
            `
            : ""
        }

      </div>
    `;

  }


  document.getElementById("main")
    .innerHTML = `

      <div class="eyebrow">
        REVIEW SYSTEM
      </div>

      <h2>
        Spaced Repetition
      </h2>

      <div class="calendar-card">

        <div class="calendar-head">

          <button
            class="btn light"
            onclick="changeMonth(-1)"
          >
            ←
          </button>

          <h3>
            ${now.toLocaleString(
              "en",
              {month:"long"}
            )}
            ${year}
          </h3>

          <button
            class="btn light"
            onclick="changeMonth(1)"
          >
            →
          </button>

        </div>

        <div class="calendar-grid">
          ${cells}
        </div>

      </div>
    `;

}
let calendarViewDate = new Date();

function changeMonth(offset){

  calendarViewDate.setMonth(
    calendarViewDate.getMonth() + offset
  );

  renderCalendar();
}


