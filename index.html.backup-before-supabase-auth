    <button data-page="review" onclick="navigate('review')">REVIEW</button>
    <button data-page="calendar" onclick="navigate('calendar')">SPACED REPETITION</button>
    <button data-page="trophies" onclick="navigate('trophies')">TROPHY ROOM</button>
    <button data-page="progress" onclick="navigate('progress')">PROGRESS</button>
  </nav>

  <div class="mute-control">
    <button
      id="muteSoundsButton"
      type="button"
      aria-label="Mute sounds"
      title="Mute sounds"
      onclick="toggleSoundMute(event)"
    >
      <svg id="muteIcon" viewBox="0 0 24 24" aria-hidden="true">
        <path class="speaker" d="M4 9v6h4l5 4V5L8 9H4z"></path>
        <path class="wave" d="M16 9c1 1 1.5 2 1.5 3s-.5 2-1.5 3"></path>
        <path class="wave" d="M18.5 6.5c1.7 1.5 2.5 3.4 2.5 5.5s-.8 4-2.5 5.5"></path>
        <path class="slash" d="M5 5l14 14"></path>
      </svg>
    </button>
  </div>

  <div class="settings-nav">
    <button class="nav" style="border:0;background:transparent;text-align:left;width:100%;padding:13px 14px;border-radius:15px;font-size:15px;cursor:pointer" data-page="settings" onclick="navigate('settings')">SETTINGS</button>
  </div>
</aside>
<main class="main" id="main"></main>
</div>
<div class="toast" id="toast"></div>
<div class="modal" id="modal">
  <div class="modal-box" id="modalBox"></div>
</div>

