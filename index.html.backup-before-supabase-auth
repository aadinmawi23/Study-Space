function createSubject(){

  const input =
    document.getElementById(
      "newSubjectName"
    );

  const color =
    document.getElementById(
      "newSubjectColor"
    );

  const name =
    input?.value.trim();

  if(!name){

    toast("Enter a subject name.");
    return;
  }

  const exists =
    SUBJECT_CATALOG.some(
      subject =>
        normalize(subject.name) ===
        normalize(name)
    );

  if(exists){

    toast("That subject already exists.");
    return;
  }

  const subject = {

    key:
      `${slugify(name)}-${Date.now()}`,

    name,

    /*
     * New subjects do not automatically
     * connect to an MCQ bank unless the
     * imported JSON uses the same subject name.
     */
    questionSubject:name,

    accent:
      color?.value || "#b99ac7",

    topics:[]
  };

  SUBJECT_CATALOG.push(subject);

  saveSubjects();

  closeModal();

  toast("Subject added.");

  renderHome();
}


