/* =========================================================
   JSON IMPORT
   ========================================================= */

async function importJSON(event){

  const file =
    event.target.files[0];

  if(!file){
    return;
  }

  try{

    const data =
      JSON.parse(
        await file.text()
      );

    const response =
      await fetch(
        "/api/question-banks/import",
        {
          method:"POST",

          headers:{
            "Content-Type":
              "application/json"
          },

          body:
            JSON.stringify({
              filename:file.name,
              data
            })
        }
      );

    const result =
      await response.json();

    if(!response.ok){
      throw new Error(
        result.error ||
        "Import failed"
      );
    }

    toast(
      `${result.questionCount} questions imported`
    );

    await loadBanks();

  }catch(error){

    toast(
      error.message
    );
  }
}


