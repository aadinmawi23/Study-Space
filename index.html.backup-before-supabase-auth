          ${SUBJECT_CATALOG.map(subject=>{

            const stats =
              subjectStats(subject);

            return `

              <div class="progress-row">

                <div class="progress-row-top">

                  <span>
                    ${escapeHTML(
                      subject.name
                    )}
                  </span>

                  <strong>
