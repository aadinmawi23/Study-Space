/* =========================================================
   TOPICS
   ========================================================= */

function renderSubjectTopics(
  container,
  subject
){

  if(!subject.topics.length){

    const matchingBanks =
      banks.filter(
        bank =>
          normalize(bank.subject) ===
          normalize(
            subject.questionSubject ||
            subject.name
          )
      );

    if(matchingBanks.length){

      subject.topics =
        [
          ...new Set(
            matchingBanks.map(
              bank => bank.topic
            )
          )
        ];

      saveSubjects();

    }
  }

  if(!subject.topics.length){

    container.innerHTML = `

      <div class="empty-state">

        <h3
          style="
            font:24px Georgia,serif;
            margin-top:0
          "
        >
          No topics yet
        </h3>

        <p>
          Import a JSON question bank for
          this subject to populate its topics.
        </p>

      </div>
    `;

    return;
  }


