   ========================================================= */

function openSubjectMenu(key,anchor){

  const subject =
    getSubject(key);

  if(!subject){
    return;
  }

  document
    .querySelectorAll(".subject-menu")
    .forEach(menu=>menu.remove());

  const menu =
    document.createElement("div");

  menu.className =
    "subject-menu";

  menu.style.cssText = `
    position:fixed;
    z-index:100;
    min-width:180px;
    background:#fffdf9;
    border:1px solid #e6ddd1;
    border-radius:14px;
    padding:7px;
    box-shadow:0 14px 35px rgba(50,40,30,.16);
  `;

  menu.innerHTML = `

    <button
      data-action="color"
      style="${menuButtonStyle()}"
    >
      Change Color
    </button>

    <button
      data-action="rename"
      style="${menuButtonStyle()}"
    >
      Rename
    </button>

    <button
      data-action="delete"
      style="${menuButtonStyle(true)}"
    >
      Delete
    </button>
  `;

  document.body.appendChild(menu);

  const rect =
    anchor.getBoundingClientRect();

  menu.style.top =
    `${rect.bottom + 6}px`;

  menu.style.left =
    `${Math.max(10,rect.right - 180)}px`;


  menu
    .querySelector('[data-action="color"]')
    .onclick = event=>{
      event.stopPropagation();
      menu.remove();
      openColorModal(key);
    };


  menu
    .querySelector('[data-action="rename"]')
    .onclick = event=>{
      event.stopPropagation();
      menu.remove();
      openRenameModal(key);
    };


  menu
    .querySelector('[data-action="delete"]')
    .onclick = event=>{
      event.stopPropagation();
      menu.remove();
      openDeleteModal(key);
    };


  setTimeout(()=>{

    document.addEventListener(
      "click",
      function closeMenu(event){

        if(!menu.contains(event.target)){
          menu.remove();

          document.removeEventListener(
            "click",
            closeMenu
          );
        }

      },
      {once:true}
    );

  },0);
}

function menuButtonStyle(danger=false){

  return `
    display:block;
    width:100%;
    border:0;
    background:transparent;
    text-align:left;
    padding:11px 12px;
    border-radius:9px;
    cursor:pointer;
    font-size:14px;
    color:${danger ? "#a55f5c" : "#403a35"};
  `;
}


