/* =========================================================
   QUIZ ENGINE
   ========================================================= */

function startQuizFor(
  subjectName,
  topic
){

  const subject =
    SUBJECT_CATALOG.find(
      s =>
        normalize(
          s.questionSubject ||
          s.name
        ) ===
        normalize(subjectName)
    );

  const qs =
    subject
      ? getQuestionsForTopic(
          subject,
          topic
        )
      : allQuestions().filter(
          q =>
            normalize(q.subject) ===
            normalize(subjectName) &&
            normalize(q.topic) ===
            normalize(topic)
        );

  if(!qs.length){

    toast(
      "No JSON questions loaded for this topic."
    );

    return;
  }

  selectedSubject =
    subject ||
    selectedSubject;

  startQuiz(qs);
}

function startQuizByIds(ids){

  const qs =
    ids
      .map(getQuestion)
      .filter(Boolean);

  if(qs.length){
    startQuiz(qs);
  }
}

function startQuiz(questions){

  currentQuiz = {

    questions:[
      ...questions
    ],

    index:0,

    answered:false,

    results:[]
  };

  renderQuiz();
}


