    if (
      typeof refreshAuthUI ===
      "function"
    ) {
      refreshAuthUI();
    }

    if (
      typeof updateAuthenticationUI ===
      "function"
    ) {
      updateAuthenticationUI();
    }

    if (
      typeof updateAccountUI ===
      "function"
    ) {
      updateAccountUI();
    }

    /*
      ALWAYS reload.
      Do not wait for Google.
    */
    setTimeout(() => {
      window.location.reload();
    }, 100);

  }

}

