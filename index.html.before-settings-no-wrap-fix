<script>

(function(){

  /*
   * ========================================================
   * STATE
   * ========================================================
   */

  const challenge = {

    roomCode:null,

    channel:null,

    playerId:
      (
        window.crypto &&
        crypto.randomUUID
      )
        ? crypto.randomUUID()
        : (
            "flo-" +
            Date.now() +
            "-" +
            Math.random()
          ),

    username:"",

    opponentUsername:"Waiting…",

    opponentId:null,

    isHost:false,

    opponentJoined:false,

    ready:false,

    opponentReady:false,

    subjectName:"",

    topic:"",

    questionIds:[],

    questions:[],

    index:0,

    answers:{},

    myScore:0,

    opponentScore:0,

    myCorrect:0,

    opponentCorrect:0,

    active:false,

    finished:false

  };


  window.__floChallenge =
    challenge;


  /*
   * ========================================================
   * QUIZ MODE MODAL
   * ========================================================
   */

  window.openQuizModeModalFinal =
    function(){

      const questions =
        window.__floQuizQuestions ||
        [];

      const modal =
        document.getElementById(
          "floQuizModeModal"
        );

      const content =
        document.getElementById(
          "floQuizModeContent"
        );

      if(
        !modal ||
        !content
      ){
        return;
      }

      content.innerHTML = `

        <div class="flo-quiz-eyebrow">
          START QUIZ
        </div>

        <h2 class="flo-quiz-title">
          How would you like to play?
        </h2>

        <p class="flo-quiz-subtitle">
          Choose Solo Study for your normal quiz,
          or Challenge Mode to compete with another
          player.
        </p>

        <button
          class="flo-quiz-choice"
          onclick="
            window.__floSelectQuizMode('solo')
          "
        >

          <strong>
            Solo Study
          </strong>

          <span>
            Practice at your own pace using the
            existing quiz and scoring system.
          </span>

        </button>


        <button
          class="flo-quiz-choice"
          onclick="
            window.__floSelectQuizMode('challenge')
          "
        >

          <strong>
            Challenge Mode
          </strong>

          <span>
            Create a room or join another player
            for a live two-player quiz.
          </span>

        </button>


        <div class="flo-quiz-actions">

          <button
            class="btn light"
            onclick="
              window.__floCloseQuizMode()
            "
          >
            Cancel
          </button>

        </div>
      `;

      modal.classList.add("open");

      modal.setAttribute(
        "aria-hidden",
        "false"
      );

    };


  window.__floCloseQuizMode =
    function(){

      const modal =
        document.getElementById(
          "floQuizModeModal"
        );

      if(!modal){
        return;
      }

      modal.classList.remove(
        "open"
      );

      modal.setAttribute(
        "aria-hidden",
        "true"
      );

    };


  window.__floSelectQuizMode =
    async function(mode){

      window.__floCloseQuizMode();

      const questions =
        window.__floQuizQuestions ||
        [];

      if(!questions.length){

        toast(
          "No questions are loaded for this topic."
        );

        return;
      }


      /*
       * SOLO STUDY
       *
       * This is the EXISTING quiz engine.
       * Nothing inside renderQuiz() or answerQuiz()
       * is changed.
       */

      if(mode === "solo"){

        const subject =
          SUBJECT_CATALOG.find(
            s =>
              normalize(
                s.questionSubject ||
                s.name
              ) ===
              normalize(
                window.pendingQuizSubject
              )
          );

        selectedSubject =
          subject ||
          selectedSubject;

        startQuiz(
          questions
        );

        return;

      }


      /*
       * CHALLENGE MODE
       */

      if(mode === "challenge"){

        const username =
          await window.__floRequireUsername();

        if(!username){
          return;
        }

        challenge.username =
          username;

        challenge.subjectName =
          window.pendingQuizSubject;

        challenge.topic =
          window.pendingQuizTopic;

        window.__floOpenChallengeChoice();

      }

    };


  /*
   * Compatibility alias.
   * There is only ONE mode-selection handler.
   */

  window.selectQuizMode =
    window.__floSelectQuizMode;


  /*
   * ========================================================
   * USERNAME
   * ========================================================
   */

  window.__floRequireUsername =
    async function(){

      if(
        typeof currentUsername !==
        "undefined" &&
        currentUsername
      ){

        return currentUsername;

      }

      if(
        typeof ensureUsername ===
        "function"
      ){

        await ensureUsername();

      }

      if(
        typeof currentUsername !==
        "undefined" &&
        currentUsername
      ){

        return currentUsername;

      }

      toast(
        "Choose a username before starting a challenge."
      );

      return null;

    };


  /*
   * ========================================================
   * CHALLENGE CHOICE
   * ========================================================
   */

  window.__floOpenChallengeChoice =
    function(){

      const modal =
        document.getElementById(
          "floChallengeModal"
        );

      const content =
        document.getElementById(
          "floChallengeContent"
        );

      if(
        !modal ||
        !content
      ){
        return;
      }

      content.innerHTML = `

        <div class="flo-quiz-eyebrow">
          CHALLENGE MODE
        </div>

        <h2 class="flo-quiz-title">
          Play with another student
        </h2>

        <p class="flo-quiz-subtitle">
          Create a room and share the code,
          or join a room using a code.
        </p>


        <button
          class="flo-quiz-choice"
          onclick="
            window.__floCreateRoom()
          "
        >

          <strong>
            Create Room
          </strong>

          <span>
            Start a room and wait for the other
            player to join.
          </span>

        </button>


        <button
          class="flo-quiz-choice"
          onclick="
            window.__floShowJoinRoom()
          "
        >

          <strong>
            Join Room
          </strong>

          <span>
            Enter the six-character room code
            from the host.
          </span>

        </button>


        <div class="flo-quiz-actions">

          <button
            class="btn light"
            onclick="
              window.__floCloseChallengeModal()
            "
          >
            Cancel
          </button>

        </div>
      `;

      modal.classList.add(
        "open"
      );

      modal.setAttribute(
        "aria-hidden",
        "false"
      );

    };


  window.__floCloseChallengeModal =
    function(){

      const modal =
        document.getElementById(
          "floChallengeModal"
        );

      if(!modal){
        return;
      }

      modal.classList.remove(
        "open"
      );

      modal.setAttribute(
        "aria-hidden",
        "true"
      );

    };


  /*
   * ========================================================
   * ROOM CODE
   * ========================================================
   */

  function createRoomCode(){

    const chars =
      "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

    let code = "";

    for(
      let i = 0;
      i < 6;
      i++
    ){

      code +=
        chars[
          Math.floor(
            Math.random() *
            chars.length
          )
        ];

    }

    return code;

  }


  /*
   * ========================================================
   * SUPABASE REALTIME
   * ========================================================
   */

  async function connectRoom(){

    if(!supabaseClient){

      toast(
        "Supabase is not connected."
      );

      return false;

    }

    if(challenge.channel){

      try{

        await supabaseClient.removeChannel(
          challenge.channel
        );

      }catch(_){}

      challenge.channel =
        null;

    }


    const channelName =
      "flo-study-challenge-" +
      challenge.roomCode;


    const channel =
      supabaseClient.channel(
        channelName
      );


    channel.on(
      "broadcast",
      {
        event:"flo-join"
      },
      ({payload}) => {

        onJoin(
          payload
        );

      }
    );


    channel.on(
      "broadcast",
      {
        event:"flo-room-state"
      },
      ({payload}) => {

        onRoomState(
          payload
        );

      }
    );


    channel.on(
      "broadcast",
      {
        event:"flo-ready"
      },
      ({payload}) => {

        onReady(
          payload
        );

      }
    );


    channel.on(
      "broadcast",
      {
        event:"flo-start"
      },
      ({payload}) => {

        onStart(
          payload
        );

      }
    );


    channel.on(
      "broadcast",
      {
        event:"flo-answer"
      },
      ({payload}) => {

        onAnswer(
          payload
        );

      }
    );


    channel.on(
      "broadcast",
      {
        event:"flo-advance"
      },
      ({payload}) => {

        onAdvance(
          payload
        );

      }
    );


    channel.on(
      "broadcast",
      {
        event:"flo-leave"
      },
      ({payload}) => {

        onLeave(
          payload
        );

      }
    );


    challenge.channel =
      channel;


    return new Promise(
      resolve => {

        let resolved =
          false;


        channel.subscribe(
          status => {

            if(
              status ===
              "SUBSCRIBED" &&
              !resolved
            ){

              resolved = true;

              resolve(
                true
              );

            }


            if(
              (
                status ===
                "CHANNEL_ERROR" ||
                status ===
                "TIMED_OUT"
              ) &&
              !resolved
            ){

              resolved = true;

              toast(
                "Could not connect to the challenge room."
              );

              resolve(
                false
              );

            }

          }
        );

      }
    );

  }


  async function broadcast(
    event,
    payload
  ){

    if(
      !challenge.channel
    ){
      return;
    }

    await challenge.channel.send({

      type:"broadcast",

      event,

      payload

    });

  }


  /*
   * ========================================================
   * CREATE ROOM
   * ========================================================
   */

  window.__floCreateRoom =
    async function(){

      const questions =
        window.__floQuizQuestions ||
        [];

      if(!questions.length){

        toast(
          "No questions are loaded for this topic."
        );

        return;

      }


      challenge.roomCode =
        createRoomCode();

      challenge.isHost =
        true;

      challenge.opponentJoined =
        false;

      challenge.opponentUsername =
        "Waiting…";

      challenge.opponentId =
        null;

      challenge.ready =
        false;

      challenge.opponentReady =
        false;

      challenge.subjectName =
        window.pendingQuizSubject;

      challenge.topic =
        window.pendingQuizTopic;

      challenge.questionIds =
        questions.map(
          q => q.id
        );

      challenge.questions =
        [...questions];


      const connected =
        await connectRoom();

      if(!connected){
        return;
      }


      renderLobby();

    };


  /*
   * ========================================================
   * JOIN ROOM
   * ========================================================
   */

  window.__floShowJoinRoom =
    function(){

      const modal =
        document.getElementById(
          "floChallengeModal"
        );

      const content =
        document.getElementById(
          "floChallengeContent"
        );

      content.innerHTML = `

        <div class="flo-quiz-eyebrow">
          JOIN ROOM
        </div>

        <h2 class="flo-quiz-title">
          Join a Challenge
        </h2>

        <p class="flo-quiz-subtitle">
          Enter the six-character room code
          shared by the host.
        </p>


        <input
          id="floJoinRoomCode"
          class="flo-room-input"
          maxlength="6"
          placeholder="ABC123"
          autocomplete="off"
          oninput="
            this.value =
              this.value
                .toUpperCase()
                .replace(/[^A-Z0-9]/g,'')
          "
        >


        <div class="flo-quiz-actions">

          <button
            class="btn light"
            onclick="
              window.__floOpenChallengeChoice()
            "
          >
            Back
          </button>


          <button
            class="btn"
            onclick="
              window.__floJoinRoom()
            "
          >
            Join Room
          </button>

        </div>
      `;

      modal.classList.add(
        "open"
      );

      modal.setAttribute(
        "aria-hidden",
        "false"
      );


      setTimeout(
        () => {

          document
            .getElementById(
              "floJoinRoomCode"
            )
            ?.focus();

        },
        50
      );

    };


  window.__floJoinRoom =
    async function(){

      const input =
        document.getElementById(
          "floJoinRoomCode"
        );

      const code =
        input?.value
          .trim()
          .toUpperCase();


      if(
        !code ||
        code.length !== 6
      ){

        toast(
          "Enter a valid six-character room code."
        );

        return;

      }


      challenge.roomCode =
        code;

      challenge.isHost =
        false;

      challenge.opponentJoined =
        true;

      challenge.ready =
        false;

      challenge.opponentReady =
        false;

      challenge.opponentUsername =
        "Waiting for host…";


      const connected =
        await connectRoom();

      if(!connected){
        return;
      }


      await broadcast(
        "flo-join",
        {
          playerId:
            challenge.playerId,

          username:
            challenge.username
        }
      );


      renderLobby();

    };


  /*
   * ========================================================
   * ROOM STATE
   * ========================================================
   */

  function getRoomState(){

    return {

      host:
        challenge.isHost
          ? {
              playerId:
                challenge.playerId,

              username:
                challenge.username,

              ready:
                challenge.ready
            }
          : challenge.host || null,

      guest:
        challenge.isHost
          ? (
              challenge.opponentJoined
                ? {
                    playerId:
                      challenge.opponentId,

                    username:
                      challenge.opponentUsername,

                    ready:
                      challenge.opponentReady
                  }
                : null
            )
          : challenge.guest || null,

      subjectName:
        challenge.subjectName,

      topic:
        challenge.topic,

      questionIds:
        challenge.questionIds

    };

  }


  function onJoin(payload){

    if(
      !challenge.isHost ||
      !payload ||
      !payload.playerId
    ){

      return;

    }


    challenge.opponentJoined =
      true;

    challenge.opponentId =
      payload.playerId;

    challenge.opponentUsername =
      payload.username ||
      "Opponent";

    challenge.opponentReady =
      false;


    broadcast(
      "flo-room-state",
      getRoomState()
    );


    renderLobby();

  }


  function onRoomState(payload){

    if(!payload){
      return;
    }


    if(payload.host){

      challenge.host =
        payload.host;

      if(
        payload.host.playerId !==
        challenge.playerId
      ){

        challenge.opponentJoined =
          true;

        challenge.opponentId =
          payload.host.playerId;

        challenge.opponentUsername =
          payload.host.username ||
          challenge.opponentUsername;

        challenge.opponentReady =
          !!payload.host.ready;

      }

    }


    if(payload.guest){

      challenge.guest =
        payload.guest;

      if(
        payload.guest.playerId ===
        challenge.playerId
      ){

        challenge.ready =
          !!payload.guest.ready;

      }else{

        challenge.opponentJoined =
          true;

        challenge.opponentId =
          payload.guest.playerId;

        challenge.opponentUsername =
          payload.guest.username ||
          challenge.opponentUsername;

        challenge.opponentReady =
          !!payload.guest.ready;

      }

    }


    if(payload.topic){

      challenge.topic =
        payload.topic;

    }


    if(payload.subjectName){

      challenge.subjectName =
        payload.subjectName;

    }


    if(
      Array.isArray(
        payload.questionIds
      )
    ){

      challenge.questionIds =
        payload.questionIds;

    }


    renderLobby();

  }


  /*
   * ========================================================
   * READY
   * ========================================================
   */

  window.__floToggleReady =
    async function(){

      if(
        !challenge.opponentJoined
      ){

        toast(
          "Waiting for another player to join."
        );

        return;

      }


      challenge.ready =
        !challenge.ready;


      await broadcast(
        "flo-ready",
        {
          playerId:
            challenge.playerId,

          username:
            challenge.username,

          ready:
            challenge.ready
        }
      );


      if(
        challenge.isHost
      ){

        await broadcast(
          "flo-room-state",
          getRoomState()
        );

      }


      renderLobby();

    };


  function onReady(payload){

    if(
      !payload ||
      payload.playerId ===
      challenge.playerId
    ){

      return;

    }


    challenge.opponentReady =
      !!payload.ready;


    renderLobby();


    if(
      challenge.isHost
    ){

      broadcast(
        "flo-room-state",
        getRoomState()
      );

    }

  }


  /*
   * ========================================================
   * LOBBY
   * ========================================================
   */

  function renderLobby(){

    const modal =
      document.getElementById(
        "floChallengeModal"
      );

    const content =
      document.getElementById(
        "floChallengeContent"
      );


    if(
      !modal ||
      !content
    ){
      return;
    }


    const bothReady =
      challenge.opponentJoined &&
      challenge.ready &&
      challenge.opponentReady;


    content.innerHTML = `

      <div class="flo-quiz-eyebrow">
        ${challenge.isHost
          ? "CREATE ROOM"
          : "JOIN ROOM"}
      </div>


      <h2 class="flo-quiz-title">
        ${escapeHTML(
          challenge.topic ||
          "Challenge Room"
        )}
      </h2>


      <p class="flo-quiz-subtitle">
        ${
          challenge.isHost
            ? "Share this code with the other player."
            : "You are in the challenge room."
        }
      </p>


      <div class="flo-room-code">

        <span class="flo-room-code-label">
          ROOM CODE
        </span>

        <span class="flo-room-code-value">
          ${escapeHTML(
            challenge.roomCode ||
            ""
          )}
        </span>

      </div>


      <div class="flo-player">

        <div class="flo-player-left">

          <span
            class="flo-player-dot ${
              challenge.ready
                ? "ready"
                : ""
            }"
          ></span>

          <div>

            <div class="flo-player-name">
              ${escapeHTML(
                challenge.username
              )}
            </div>

            <div class="flo-player-status">
              You · ${
                challenge.ready
                  ? "Ready"
                  : "Not ready"
              }
            </div>

          </div>

        </div>

      </div>


      <div class="flo-player">

        <div class="flo-player-left">

          <span
            class="flo-player-dot ${
              challenge.opponentReady
                ? "ready"
                : ""
            }"
          ></span>

          <div>

            <div class="flo-player-name">
              ${escapeHTML(
                challenge.opponentUsername
              )}
            </div>

            <div class="flo-player-status">
              ${
                challenge.opponentJoined
                  ? (
                      challenge.opponentReady
                        ? "Ready"
                        : "Not ready"
                    )
                  : "Waiting for opponent…"
              }
            </div>

          </div>

        </div>

      </div>


      <div class="flo-room-status">

        ${
          !challenge.opponentJoined
            ? "Waiting for another player to join…"
            : !challenge.ready
              ? "Click Ready when you are ready."
              : !challenge.opponentReady
                ? "Waiting for the other player to ready up…"
                : "Both players are ready."
        }

      </div>


      <div class="flo-quiz-actions">

        ${
          challenge.isHost &&
          !challenge.opponentJoined
            ? `
              <button
                class="btn light"
                onclick="
                  window.__floCopyRoomCode()
                "
              >
                Copy Code
              </button>
            `
            : ""
        }


        ${
          challenge.opponentJoined
            ? `
              <button
                class="btn"
                onclick="
                  window.__floToggleReady()
                "
              >
                ${
                  challenge.ready
                    ? "Not Ready"
                    : "Ready"
                }
              </button>
            `
            : ""
        }


        ${
          challenge.isHost &&
          bothReady
            ? `
              <button
                class="btn"
                onclick="
                  window.__floStartChallenge()
                "
              >
                Start Challenge
              </button>
            `
            : ""
        }


        <button
          class="btn light"
          onclick="
            window.__floLeaveChallenge()
          "
        >
          Leave Room
        </button>

      </div>

    `;


    modal.classList.add(
      "open"
    );

    modal.setAttribute(
      "aria-hidden",
      "false"
    );

  }


  window.__floCopyRoomCode =
    async function(){

      try{

        await navigator.clipboard.writeText(
          challenge.roomCode
        );

        toast(
          "Room code copied."
        );

      }catch(_){

        toast(
          "Room code: " +
          challenge.roomCode
        );

      }

    };


  /*
   * ========================================================
   * START SHARED QUIZ
   * ========================================================
   */

  window.__floStartChallenge =
    async function(){

      if(
        !challenge.isHost ||
        !challenge.opponentJoined ||
        !challenge.ready ||
        !challenge.opponentReady
      ){

        return;

      }


      await broadcast(
        "flo-start",
        {
          subjectName:
            challenge.subjectName,

          topic:
            challenge.topic,

          questionIds:
            challenge.questionIds
        }
      );


      beginChallenge(
        challenge.questionIds
      );

    };


  function onStart(payload){

    if(!payload){
      return;
    }


    if(
      payload.subjectName
    ){

      challenge.subjectName =
        payload.subjectName;

    }


    if(payload.topic){

      challenge.topic =
        payload.topic;

    }


    if(
      Array.isArray(
        payload.questionIds
      )
    ){

      challenge.questionIds =
        payload.questionIds;

    }


    beginChallenge(
      challenge.questionIds
    );

  }


  function beginChallenge(ids){

    const all =
      allQuestions();


    challenge.questions =
      (ids || [])
        .map(
          id =>
            all.find(
              q =>
                String(q.id) ===
                String(id)
            )
        )
        .filter(Boolean);


    if(
      !challenge.questions.length
    ){

      toast(
        "The challenge questions could not be loaded."
      );

      return;

    }


    challenge.index =
      0;

    challenge.answers =
      {};

    challenge.myScore =
      0;

    challenge.opponentScore =
      0;

    challenge.myCorrect =
      0;

    challenge.opponentCorrect =
      0;

    challenge.active =
      true;

    challenge.finished =
      false;


    window.__floCloseChallengeModal();

    renderChallengeQuiz();

  }


  /*
   * ========================================================
   * ANSWERS
   * ========================================================
   */

  window.__floAnswerChallenge =
    function(choice){

      if(
        !challenge.active
      ){
        return;
      }


      const q =
        challenge.questions[
          challenge.index
        ];


      if(!q){
        return;
      }


      if(
        !challenge.answers[
          challenge.index
        ]
      ){

        challenge.answers[
          challenge.index
        ] = {
          me:null,
          opponent:null
        };

      }


      const slot =
        challenge.answers[
          challenge.index
        ];


      if(slot.me){
        return;
      }


      const result =
        choice === "UNKNOWN"
          ? "unknown"
          : choice === q.answer
            ? "correct"
            : "wrong";


      slot.me = {

        choice,

        result

      };


      if(
        result ===
        "correct"
      ){

        challenge.myScore++;

        challenge.myCorrect++;

        if(
          typeof playAppSound ===
          "function"
        ){

          playAppSound(
            "correct"
          );

        }

      }else{

        if(
          typeof playAppSound ===
          "function"
        ){

          playAppSound(
            "wrong"
          );

        }

      }


      broadcast(
        "flo-answer",
        {
          playerId:
            challenge.playerId,

          username:
            challenge.username,

          index:
            challenge.index,

          choice,

          result

        }
      );


      renderChallengeQuiz();

    };


  function onAnswer(payload){

    if(
      !payload ||
      payload.playerId ===
      challenge.playerId
    ){

      return;

    }


    if(
      payload.index !==
      challenge.index
    ){

      return;

    }


    if(
      !challenge.answers[
        challenge.index
      ]
    ){

      challenge.answers[
        challenge.index
      ] = {

        me:null,

        opponent:null

      };

    }


    const slot =
      challenge.answers[
        challenge.index
      ];


    if(slot.opponent){
      return;
    }


    challenge.opponentUsername =
      payload.username ||
      challenge.opponentUsername;


    slot.opponent = {

      choice:
        payload.choice,

      result:
        payload.result

    };


    if(
      payload.result ===
      "correct"
    ){

      challenge.opponentScore++;

      challenge.opponentCorrect++;

    }


    renderChallengeQuiz();

  }


  /*
   * ========================================================
   * NEXT QUESTION
   * ========================================================
   */

  window.__floNextChallengeQuestion =
    async function(){

      if(
        !challenge.active
      ){
        return;
      }


      const slot =
        challenge.answers[
          challenge.index
        ];


      if(
        !slot ||
        !slot.me ||
        !slot.opponent
      ){

        return;

      }


      if(
        challenge.index >=
        challenge.questions.length - 1
      ){

        finishChallenge();

        return;

      }


      /*
       * Host advances the shared question.
       * This keeps both devices synchronized.
       */

      if(
        !challenge.isHost
      ){

        return;

      }


      const next =
        challenge.index + 1;


      await broadcast(
        "flo-advance",
        {
          index:next
        }
      );


      advanceChallenge(
        next
      );

    };


  function onAdvance(payload){

    if(
      !payload ||
      typeof payload.index !==
      "number"
    ){

      return;

    }


    advanceChallenge(
      payload.index
    );

  }


  function advanceChallenge(index){

    if(
      index !==
      challenge.index + 1
    ){

      return;

    }


    challenge.index =
      index;


    renderChallengeQuiz();

  }


  /*
   * ========================================================
   * CHALLENGE QUIZ UI
   * ========================================================
   */

  function renderChallengeQuiz(){

    const main =
      document.getElementById(
        "main"
      );


    const q =
      challenge.questions[
        challenge.index
      ];


    if(
      !main ||
      !q
    ){
      return;
    }


    if(
      !challenge.answers[
        challenge.index
      ]
    ){

      challenge.answers[
        challenge.index
      ] = {

        me:null,

        opponent:null

      };

    }


    const slot =
      challenge.answers[
        challenge.index
      ];


    const myAnswered =
      !!slot.me;


    const bothAnswered =
      !!slot.me &&
      !!slot.opponent;


    const number =
      challenge.index + 1;


    const total =
      challenge.questions.length;


    main.innerHTML = `

      <div class="flo-challenge-shell">

        <div class="flo-challenge-header">

          <div>

            <div class="flo-challenge-label">
              CHALLENGE MODE
            </div>

            <div class="flo-challenge-topic">
              ${escapeHTML(
                challenge.topic ||
                ""
              )}
            </div>

            <div class="flo-challenge-question-count">
              Question ${number} / ${total}
            </div>

          </div>


          <button
            class="btn light"
            onclick="
              window.__floLeaveChallenge()
            "
          >
            ← Exit Challenge
          </button>

        </div>


        <div class="flo-challenge-scores">

          <div class="flo-score-card">

            <div class="flo-score-name">
              ${escapeHTML(
                challenge.username
              )}
            </div>

            <div class="flo-score">
              ${challenge.myScore}
            </div>

          </div>


          <div class="flo-score-divider"></div>


          <div class="flo-score-card right">

            <div class="flo-score-name">
              ${escapeHTML(
                challenge.opponentUsername
              )}
            </div>

            <div class="flo-score">
              ${challenge.opponentScore}
            </div>

          </div>

        </div>


        <div class="flo-question-card">

          <div class="flo-question-number">
            QUESTION ${number} / ${total}
          </div>


          <h2 class="flo-question-text">
            ${escapeHTML(
              q.question
            )}
          </h2>


          <div class="flo-options">

            ${["A","B","C","D"].map(
              letter => {

                let extra = "";

                if(
                  bothAnswered &&
                  letter === q.answer
                ){

                  extra +=
                    " correct";

                }


                if(
                  bothAnswered &&
                  slot.me &&
                  slot.me.result ===
                    "wrong" &&
                  slot.me.choice ===
                    letter
                ){

                  extra +=
                    " wrong";

                }


                return `

                  <button
                    class="
                      flo-option
                      ${extra}
                      ${myAnswered
                        ? "locked"
                        : ""}
                    "
                    ${
                      myAnswered
                        ? "disabled"
                        : ""
                    }
                    onclick="
                      window.__floAnswerChallenge(
                        '${letter}'
                      )
                    "
                  >

                    <span class="flo-option-letter">
                      ${letter}
                    </span>

                    <span>
                      ${escapeHTML(
                        q.options[
                          letter
                        ]
                      )}
                    </span>

                  </button>

                `;

              }
            ).join("")}

          </div>


          <div class="flo-challenge-bottom">

            <button
              class="unknown"
              ${
                myAnswered
                  ? "disabled"
                  : ""
              }
              onclick="
                window.__floAnswerChallenge(
                  'UNKNOWN'
                )
              "
            >
              I don't know
            </button>


            <div class="flo-challenge-message">

              ${
                !myAnswered
                  ? "Choose your answer."
                  : !bothAnswered
                    ? "<strong>Answer locked.</strong> Waiting for the other player…"
                    : "Both players have answered. Answer revealed."
              }

            </div>


            ${
              bothAnswered
                ? (
                    challenge.index <
                    challenge.questions.length - 1
                      ? (
                          challenge.isHost
                            ? `
                              <button
                                class="btn"
                                onclick="
                                  window.__floNextChallengeQuestion()
                                "
                              >
                                Next Question →
                              </button>
                            `
                            : `
                              <span class="small">
                                Waiting for host…
                              </span>
                            `
                        )
                      : `
                        <button
                          class="btn"
                          onclick="
                            window.__floFinishChallenge()
                          "
                        >
                          Challenge Complete
                        </button>
                      `
                  )
                : ""
            }

          </div>


          ${
            bothAnswered
              ? `

                <div class="flo-answer-summary">

                  <strong>
                    ${escapeHTML(
                      challenge.username
                    )}
                  </strong>

                  :
                  ${
                    slot.me.result ===
                    "correct"
                      ? "Correct"
                      : slot.me.result ===
                        "unknown"
                        ? "Not learnt"
                        : "Incorrect"
                  }

                  &nbsp; · &nbsp;

                  <strong>
                    ${escapeHTML(
                      challenge.opponentUsername
                    )}
                  </strong>

                  :
                  ${
                    slot.opponent.result ===
                    "correct"
                      ? "Correct"
                      : slot.opponent.result ===
                        "unknown"
                        ? "Not learnt"
                        : "Incorrect"
                  }

                </div>

              `
              : ""
          }

        </div>

      </div>
    `;

  }


  /*
   * ========================================================
   * RESULTS
   * ========================================================
   */

  window.__floFinishChallenge =
    function(){

      if(
        challenge.finished
      ){
        return;
      }


      challenge.active =
        false;

      challenge.finished =
        true;


      if(
        typeof playAppSound ===
        "function"
      ){

        playAppSound(
          "complete"
        );

      }


      const total =
        challenge.questions.length;


      const myAccuracy =
        Math.round(
          challenge.myCorrect /
          Math.max(
            1,
            total
          ) *
          100
        );


      const opponentAccuracy =
        Math.round(
          challenge.opponentCorrect /
          Math.max(
            1,
            total
          ) *
          100
        );


      const main =
        document.getElementById(
          "main"
        );


      main.innerHTML = `

        <div class="flo-challenge-shell">

          <div class="flo-question-card flo-result-box">

            <div class="flo-challenge-label">
              CHALLENGE COMPLETE
            </div>


            <h2 class="flo-result-title">
              Challenge Complete
            </h2>


            <p class="flo-result-subtitle">
              ${escapeHTML(
                challenge.topic ||
                ""
              )}
            </p>


            <div class="flo-result-grid">

              <div class="flo-result-card">

                <div class="flo-result-name">
                  ${escapeHTML(
                    challenge.username
                  )}
                </div>

                <div class="flo-result-score">
                  ${challenge.myScore}
                </div>

                <div class="flo-result-accuracy">
                  ${myAccuracy}% accuracy
                </div>

              </div>


              <div class="flo-result-card">

                <div class="flo-result-name">
                  ${escapeHTML(
                    challenge.opponentUsername
                  )}
                </div>

                <div class="flo-result-score">
                  ${challenge.opponentScore}
                </div>

                <div class="flo-result-accuracy">
                  ${opponentAccuracy}% accuracy
                </div>

              </div>

            </div>


            <div class="flo-quiz-actions">

              <button
                class="btn light"
                onclick="
                  window.__floLeaveChallenge()
                "
              >
                Back to Topic
              </button>


              <button
                class="btn"
                onclick="
                  startQuizFor(
                    ${JSON.stringify(
                      challenge.subjectName
                    )},
                    ${JSON.stringify(
                      challenge.topic
                    )}
                  )
                "
              >
                Play Again
              </button>

            </div>

          </div>

        </div>
      `;

    };


  /*
   * ========================================================
   * LEAVE
   * ========================================================
   */

  window.__floLeaveChallenge =
    async function(){

      if(
        challenge.channel
      ){

        try{

          await broadcast(
            "flo-leave",
            {
              playerId:
                challenge.playerId
            }
          );

        }catch(_){}


        try{

          await supabaseClient.removeChannel(
            challenge.channel
          );

        }catch(_){}

      }


      challenge.channel =
        null;

      challenge.roomCode =
        null;

      challenge.active =
        false;

      challenge.finished =
        false;

      challenge.opponentJoined =
        false;

      challenge.opponentReady =
        false;

      challenge.opponentUsername =
        "Waiting…";


      window.__floCloseChallengeModal();


      if(selectedSubject){

        renderSubject(
          selectedSubject,
          "topics"
        );

      }else{

        navigate(
          "home"
        );

      }

    };


  function onLeave(payload){

    if(
      payload &&
      payload.playerId ===
      challenge.playerId
    ){

      return;

    }


    challenge.opponentJoined =
      false;

    challenge.opponentReady =
      false;

    challenge.opponentId =
      null;

    challenge.opponentUsername =
      "Waiting…";


    if(
      challenge.active
    ){

      challenge.active =
        false;


      toast(
        "The other player left the challenge."
      );


      if(
        challenge.channel
      ){

        try{

          supabaseClient.removeChannel(
            challenge.channel
          );

        }catch(_){}

        challenge.channel =
          null;

      }


      if(selectedSubject){

        renderSubject(
          selectedSubject,
          "topics"
        );

      }else{

        navigate(
          "home"
        );

      }

      return;

    }


    renderLobby();

  }


  /*
   * Clicking either overlay backdrop closes it.
   * The inner cards stop propagation.
   */

  document
    .getElementById(
      "floQuizModeModal"
    )
    ?.addEventListener(
      "click",
      function(event){

        if(
          event.target ===
          this
        ){

          window.__floCloseQuizMode();

        }

      }
    );


  document
    .getElementById(
      "floChallengeModal"
    )
    ?.addEventListener(
      "click",
      function(event){

        if(
          event.target ===
          this
        ){

          window.__floCloseChallengeModal();

        }

      }
    );


})();

</script>

