function toast(message){
  const t = document.getElementById("toast");

  t.textContent = message;
  t.style.display = "block";

  clearTimeout(window._toast);

  window._toast = setTimeout(()=>{
    t.style.display = "none";
  },2300);
}

function normalize(value){
  return String(value || "")
    .trim()
    .toLowerCase()
    .replace(/\s+/g," ");
}

function slugify(value){
  return normalize(value)
    .replace(/[^a-z0-9]+/g,"-")
    .replace(/^-+|-+$/g,"")
    .slice(0,60);
}

function escapeHTML(value){
  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}

function dateKey(date = new Date()){
  return date.toISOString().slice(0,10);
}

function addDays(days){
  const d = new Date();

  d.setDate(
    d.getDate() + days
  );

  return dateKey(d);
}


/* =========================================================
   QUESTION BANK HELPERS
   ========================================================= */

function allQuestions(){

  return banks.flatMap(bank =>
    bank.questions.map(question => ({
      ...question,

      subject:
        question.subject ||
        bank.subject,

      topic:
        question.topic ||
        bank.topic,

      source:
        question.source ||
        bank.source
    }))
  );
}

function getQuestion(id){
  return allQuestions()
    .find(question => question.id === id);
}

function getSubject(key){
  return SUBJECT_CATALOG
    .find(subject => subject.key === key);
}

function getQuestionsForSubject(subject){
  const questionSubject =
    subject.questionSubject || subject.name;

  return allQuestions()
    .filter(question =>
      normalize(question.subject) ===
      normalize(questionSubject)
    );
}

function getQuestionsForTopic(subject,topic){

  const questionSubject =
    subject.questionSubject || subject.name;

  return allQuestions()
    .filter(question =>
      normalize(question.subject) ===
      normalize(questionSubject) &&
      normalize(question.topic) ===
      normalize(topic)
    );
}


