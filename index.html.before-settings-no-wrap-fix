async function initializeSupabase() {
  try {
    const response =
      await fetch("/api/supabase-config");

    const config =
      await response.json();

    if (
      !response.ok ||
      !config.url ||
      !config.key
    ) {
      throw new Error(
        "Supabase configuration unavailable."
      );
    }

    supabaseClient =
      window.supabase.createClient(
        config.url,
        config.key
      );

    const {
      data
    } =
      await supabaseClient.auth.getSession();

    supabaseSession =
      data.session || null;

    updateAuthenticationUI();

    /*
     * Do NOT block page initialization while loading
     * the user's username. The dashboard is already
     * rendered and should remain immediately usable.
     */
    if(supabaseSession?.user){
      ensureUsername().catch(error => {
        console.warn(
          "Username initialization failed:",
          error
        );
      });
    }

    console.log(
      supabaseSession
        ? "Supabase connected — session found."
        : "Supabase connected — no active session."
    );

    supabaseClient.auth.onAuthStateChange(
      (event, session) => {

        supabaseSession =
          session || null;

        updateAuthenticationUI();

        if(event === "SIGNED_IN" && supabaseSession?.user){

          showAuthStatusToast(
            "Signed in"
          );

          ensureUsername();

        }

        if(event === "SIGNED_OUT"){

          showAuthStatusToast(
            "Signed out"
          );

        }

        console.log(
          supabaseSession
            ? "Supabase auth session active."
            : "Supabase auth session ended."
        );
      }
    );

  } catch (error) {

    console.error(
      "Supabase initialization failed:",
      error
    );

    showLoginError(
      "Unable to connect to the sign-in service."
    );
  }
}

