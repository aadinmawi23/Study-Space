      nextReview:null,
      interval:0
    };
  }

  return performance[id];
}

function calculateMastery(p){

  if(!p.attempts){
    return 0;
  }

  const accuracy =
    p.correct / p.attempts;

  const repetition =
    Math.min(1,p.streak / 5);

  return Math.round(
    (
      accuracy * 0.7 +
      repetition * 0.3
    ) * 100
  );
}

function recordAnswer(q,chosen,result){

  const p = perf(q.id);

  p.attempts++;

  if(result === "correct"){

    p.correct++;
    p.streak++;

    const intervals = {
      0:1,
      1:3,
      3:7,
      7:14,
      14:30,
      30:30
    };

    p.interval =
      intervals[p.interval] ?? 30;

    p.nextReview =
      addDays(p.interval);

  }else{

    if(result === "wrong"){
      p.wrong++;
    }

    if(result === "unknown"){
      p.unknown++;
    }

    p.streak = 0;
    p.interval = 0;
    p.nextReview = dateKey();
  }

  p.mastery =
    calculateMastery(p);

  p.lastAttempted =
    new Date().toISOString();

  answerHistory.push({
    questionId:q.id,
    timestamp:new Date().toISOString(),
    answer:chosen,
    correctAnswer:q.answer,
    result
  });

  save();

  /* Also persist to server.js */
  fetch("/api/performance/answer",{
    method:"POST",
    headers:{
      "Content-Type":"application/json",
      ...(supabaseSession?.access_token
        ? {
            "Authorization":
              `Bearer ${supabaseSession.access_token}`
          }
        : {})
    },
    body:JSON.stringify({
      questionId:q.id,
      answer:chosen,
      result,
      timestamp:p.lastAttempted
    })
  }).catch(error=>{
    console.warn(
      "Server performance sync failed:",
      error
    );
  });
}


/* =========================================================
   SUBJECT / TOPIC STATS
   ========================================================= */

function subjectStats(subject){

  const qs =
    getQuestionsForSubject(subject);

  const mastered =
    qs.reduce(
      (total,q) =>
        total + perf(q.id).mastery,
      0
    );

  return {
    questions:qs.length,

    mastery:
      qs.length
        ? Math.round(mastered / qs.length)
        : 0,

    answered:
      qs.filter(
        q => perf(q.id).attempts > 0
      ).length,

    due:
      qs.filter(
        q =>
          perf(q.id).nextReview &&
          perf(q.id).nextReview <= dateKey()
      ).length
  };
}

function topicStats(subject,topic){

  const qs =
    getQuestionsForTopic(subject,topic);

  const mastery =
    qs.length
      ? Math.round(
          qs.reduce(
            (total,q) =>
              total + perf(q.id).mastery,
            0
          ) / qs.length
        )
      : 0;

  return {
    questions:qs.length,
    mastery,

    due:
      qs.filter(
        q =>
          perf(q.id).nextReview &&
          perf(q.id).nextReview <= dateKey()
      ).length
  };
}


/* =========================================================
   LOAD QUESTION BANKS
   ========================================================= */

async function loadBanks(){

  let data;

  try{

    const response =
      await fetch("/api/question-banks");

    if(!response.ok){
      throw new Error(
        "Question bank API returned HTTP " +
        response.status
      );
    }

    data =
      await response.json();

  }catch(error){

    console.error(
      "Question bank request failed:",
      error
    );

    banks = [];

    render();

    toast(
      "Could not load question banks. Check the server connection."
    );

    return;
  }

  banks =
    data.banks || [];

  if(data.errors?.length){

    console.warn(
      "Question bank errors:",
      data.errors
    );
  }

  console.log(
    "Question banks loaded:",
    banks.length,
    "banks"
  );

  console.log(
    "Total questions:",
    banks.reduce(
      (total, bank) =>
        total +
        (bank.questions?.length || 0),
      0
    )
  );

  // The question banks have successfully loaded.
  // UI/authentication errors must not erase them.
  try{

    render();

    updateAuthenticationUI();

  }catch(error){

    console.error(
      "Dashboard rendering/auth UI error:",
      error
    );

    // Keep the successfully loaded banks.
    // Do not replace them with an empty array.
    render();
  }
}


/* =========================================================
   NAVIGATION
   ========================================================= */

let floPageHistory = [];

function floCurrentPage(){

  return location.hash.slice(1) || "home";
}


function navigate(page){

  const current =
    floCurrentPage();

  if(current !== page){

    floPageHistory.push(current);

  }

  selectedSubject = null;
  currentQuiz = null;

  history.replaceState(
    {},
    "",
    `#${page}`
  );

  render(page);
}


function goToPreviousPage(){

  const previous =
    floPageHistory.length
      ? floPageHistory.pop()
      : "home";

  selectedSubject = null;
  currentQuiz = null;

  history.replaceState(
    {},
    "",
    `#${previous}`
  );

  render(previous);
}

function installUniversalBackButton(){

  const main =
    document.getElementById("main");

  if(!main){
    return;
  }

  const existing =
    main.querySelector(".dashboard-back-button");

  if(existing){
    existing.remove();
  }

  const page =
    floCurrentPage();

  if(page === "home"){
    return;
  }

  main.insertAdjacentHTML(
    "afterbegin",
    `
      <button
        class="dashboard-back-button"
        type="button"
        onclick="goToPreviousPage()"
        aria-label="Go back"
        title="Go back"
      ></button>
    `
  );
}


function render(page){

  page =
    page ||
    location.hash.slice(1) ||
    "home";

  document
    .querySelectorAll("[data-page]")
    .forEach(button=>{
      button.classList.toggle(
        "active",
        button.dataset.page === page
      );
    });

  if(page === "home"){
    renderHome();
  }
  else if(page === "review"){
    renderReview();
  }
  else if(page === "calendar"){
    renderCalendar();
  }
  else if(page === "trophies"){
    renderTrophies();
  }
  else if(page === "progress"){
    renderProgress();
  }
  else if(page === "settings"){
    renderSettings();
  }
  else{
    renderHome();
  }

  installUniversalBackButton();
}


