<script id="quiz-mode-modal-script">

function openQuizModeModal() {
  const modal = document.getElementById("quizModeModal");

  if (!modal) {
    console.error("Quiz mode modal not found.");
    return;
  }

  modal.classList.add("open");
  modal.setAttribute("aria-hidden", "false");
}

function closeQuizModeModal(event) {

  if (event && event.target !== event.currentTarget) {
    return;
  }

  const modal = document.getElementById("quizModeModal");

  if (!modal) return;

  modal.classList.remove("open");
  modal.setAttribute("aria-hidden", "true");
}

function selectQuizMode(mode) {

  closeQuizModeModal();

  if (mode === "solo") {

    /*
      Existing quiz flow will be connected here.
      For now this only records the selected mode.
    */

    window.selectedQuizMode = "solo";

    console.log("Quiz mode selected: Solo Study");

    return;
  }

  if (mode === "challenge") {

    window.selectedQuizMode = "challenge";

    console.log("Quiz mode selected: Challenge Mode");

    /*
      The Challenge Mode room screen
      will be connected here next.
    */

    return;
  }
}

</script>

