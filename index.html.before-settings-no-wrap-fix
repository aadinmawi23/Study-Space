/* =========================================================
   CALENDAR
   ========================================================= */

function renderCalendar(){

  const now =
    calendarViewDate;

  const year =
    now.getFullYear();

  const month =
    now.getMonth();

  const first =
    new Date(
      year,
      month,
      1
    );

  const days =
    new Date(
      year,
      month + 1,
      0
    ).getDate();

  const start =
    first.getDay();


  /*
   * Render the calendar shell immediately.
   * Do not wait for Supabase/server data.
   */

  renderCalendarGrid(
    year,
    month,
    days,
    start,
    {}
  );


  /*
   * Load review information in the background.
   */

  fetch(
    "/api/review-calendar",
    {
      headers:
        supabaseSession?.access_token
          ? {
              "Authorization":
                `Bearer ${supabaseSession.access_token}`
            }
          : {}
    }
  )
  .then(response => {

    if(!response.ok){
      throw new Error(
        `Review calendar request failed: ${response.status}`
      );
    }

    return response.json();

  })
  .then(reviewData => {

    renderCalendarGrid(
      year,
      month,
      days,
      start,
      reviewData?.calendar || {}
    );

  })
  .catch(error => {

    console.error(
      "Failed to load review calendar:",
      error
    );

  });

}


function renderCalendarGrid(
  year,
  month,
  days,
  start,
  calendar
){

  const dueBy = {};

  Object.keys(calendar || {}).forEach(date => {

    dueBy[date] =
      calendar[date] || [];

  });


  let cells = "";


  [
    "Sun",
    "Mon",
    "Tue",
    "Wed",
    "Thu",
    "Fri",
    "Sat"
  ].forEach(day => {

    cells += `
      <div class="day-name">
        ${day}
      </div>
    `;

  });


  for(
    let i = 0;
    i < start;
    i++
  ){

    cells += "<div></div>";

  }


  for(
    let day = 1;
    day <= days;
    day++
  ){

    const key =
      `${year}-${String(month + 1).padStart(2,"0")}-${String(day).padStart(2,"0")}`;

    const reviews =
      dueBy[key] || [];


    const topics = [
      ...new Map(
        reviews.map(item => [
          `${item.subject}|||${item.topic}`,
          item
        ])
      ).values()
    ];


    cells += `

      <div
        class="day ${
          key === dateKey()
            ? "today"
            : ""
        }"
        ${
          reviews.length
            ? `onclick='startQuizByIds(
                ${JSON.stringify(
                  reviews.map(
                    item => item.questionId
                  )
                )}
              )'`
            : ""
        }
      >

        <div class="num">
          ${day}
        </div>

        ${
          topics.length
            ? `
              <div class="due">
                ${topics.length}
                ${topics.length === 1
                  ? "topic"
                  : "topics"}
              </div>
            `
            : ""
        }

      </div>
    `;

  }


  const main =
    document.getElementById("main");

  if(!main){
    return;
  }


  main.innerHTML = `

    <button
      class="dashboard-back-button spaced-repetition-dashboard-back"
      type="button"
      onclick="navigate('home')"
      aria-label="Back to Dashboard"
      title="Back to Dashboard"
    ></button>

    <h2>
      Spaced Repetition
    </h2>

    <div class="calendar-card">

      <div class="calendar-head">

        <button
          class="btn light"
          onclick="changeMonth(-1)"
        >
          ←
        </button>

        <h3>
          ${new Date(year, month, 1).toLocaleString(
            "en",
            {month:"long"}
          )}
          ${year}
        </h3>

        <button
          class="btn light"
          onclick="changeMonth(1)"
        >
          →
        </button>

      </div>

      <div class="calendar-grid">
        ${cells}
      </div>

    </div>

  `;

}


let calendarViewDate = new Date();

function changeMonth(offset){

  calendarViewDate.setMonth(
    calendarViewDate.getMonth() + offset
  );

  renderCalendar();
}


