<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Dashboard</title>
<style>
:root{
  --bg:#f7f1e8;--sidebar:#eee5d8;--card:#fffdf9;--ink:#403a35;--muted:#8d857c;
  --line:#e6ddd1;--accent:#d28b72;--green:#9fbea7;--red:#d99a98;--shadow:0 8px 24px rgba(71,57,45,.05);
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif}
button{font:inherit;color:inherit}
.app{display:flex;min-height:100vh}
.sidebar{width:260px;min-width:260px;background:var(--sidebar);padding:34px 20px;display:flex;flex-direction:column;position:fixed;inset:0 auto 0 0}
.brand{padding:0 14px 42px}
.brand h1{font-family:Georgia,serif;font-size:29px;line-height:1.22;margin:0 0 9px}
.brand p{margin:0;color:var(--muted);font-size:14px}
.nav-title{font-size:11px;letter-spacing:2px;color:#9a9187;margin:0 14px 12px;font-weight:700}
.nav{display:flex;flex-direction:column;gap:5px}
.nav button,button.nav{border:0;background:transparent;text-align:left;padding:13px 14px;border-radius:15px;font-size:15px;cursor:pointer}
.nav button:hover,button.nav:hover{background:rgba(255,255,255,.42)}
.nav button.active,button.nav.active{background:#fffdf9;font-weight:700;box-shadow:var(--shadow)}
.nav button.active:before,button.nav.active:before{content:"";display:inline-block;flex:0 0 7px;width:7px;height:7px;border-radius:50%;background:var(--accent);margin-right:12px;vertical-align:middle}
.settings-nav{margin-top:auto}
.settings-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}

.settings-button{
  white-space:nowrap !important;
}
.main{margin-left:260px;width:calc(100% - 260px);padding:36px 52px 70px;min-height:100vh}
.eyebrow{font-size:11px;letter-spacing:2.5px;font-weight:700;color:#958c83;margin-bottom:7px}
h2{font:42px Georgia,serif;margin:0 0 30px;letter-spacing:-1px}
.page-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px}
.page-head h2{margin-bottom:0}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.subject-card{padding:20px;background:var(--card);border:1px solid rgba(220,211,201,.6);border-radius:22px;height:184px;min-height:184px;box-shadow:var(--shadow);cursor:pointer;position:relative;overflow:hidden}
.subject-card:before{content:"";position:absolute;left:0;right:0;top:0;height:8px;background:var(--card-accent,#d9a27f)}
.subject-card:hover{transform:translateY(-2px);transition:.15s}
.subject-card h3{font:20px Georgia,serif;margin:0 38px 20px 2px;line-height:1.18}
.more{position:absolute;right:25px;top:24px;border:0;background:transparent;font-size:21px;color:#938a81;cursor:pointer}
.meta{font-size:13px;color:#91887e;margin-bottom:20px}
.mastery-label{display:flex;justify-content:space-between;font-size:12px;letter-spacing:1.7px;color:#958b81;margin-bottom:8px}
.mastery-label strong{letter-spacing:0;color:var(--ink);font-size:13px}
.bar{height:6px;background:#ebe5de;border-radius:9px;overflow:hidden}
.fill{height:100%;background:#bfa99a;border-radius:9px;width:0}
.empty-state{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:40px;text-align:center;color:var(--muted)}
.btn{border:0;border-radius:12px;background:#403a35;color:white;padding:12px 18px;font-weight:700;cursor:pointer}
.btn.light{background:var(--card);color:var(--ink);border:1px solid var(--line)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.topic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.topic-card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:21px}
.topic-card h3{font:20px Georgia,serif;margin:0 0 10px}
.topic-card .topic-meta{font-size:13px;color:var(--muted);margin-bottom:14px}
.topic-actions{display:flex;gap:8px;margin-top:15px}
.topic-actions button{font-size:13px}
.tabs{display:flex;gap:6px;border-bottom:1px solid var(--line);margin-bottom:28px}
.tabs button{border:0;background:transparent;padding:13px 17px;cursor:pointer;color:var(--muted)}
.tabs button.active{color:var(--ink);font-weight:700;border-bottom:2px solid var(--ink)}
.quiz-shell{max-width:900px;margin:auto}
.quiz-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.quiz-count{font-size:13px;color:var(--muted)}
.quiz-progress{height:7px;background:#e8e0d6;border-radius:8px;overflow:hidden;margin-bottom:35px}
.quiz-progress .fill{background:#a98f7d}
.question-card{background:var(--card);border:1px solid var(--line);border-radius:25px;padding:38px;box-shadow:var(--shadow)}
.question-card h3{font:27px Georgia,serif;line-height:1.42;margin:0 0 30px}
.options{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.option{background:#fffdfa;border:1px solid var(--line);border-radius:16px;padding:22px;text-align:left;cursor:pointer;min-height:92px;display:flex;gap:15px;align-items:flex-start}
.option:hover{border-color:#b9aaa0}
.option .letter{font-weight:700;min-width:26px}
.option.correct{background:#e3f0e6;border-color:#9fc1a9}
.option.wrong{background:#f6dfdf;border-color:#d59b9b}
.option.disabled{cursor:default}
.explanation{margin-top:20px;padding:17px 19px;background:#f5eee6;border-radius:14px;color:#6f675f;line-height:1.5}
.quiz-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:23px}
.unknown{background:transparent;border:1px solid var(--line);border-radius:12px;padding:11px 18px;cursor:pointer}
.quiz-next{display:flex;justify-content:flex-end;margin-top:0}
.review-card,.calendar-card,.progress-card,.settings-card,.trophy-card{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:28px;box-shadow:var(--shadow)}
.review-layout{display:grid;grid-template-columns:1.5fr .75fr;gap:20px}
.review-list{display:flex;flex-direction:column;gap:11px}
.review-item{padding:17px;border:1px solid var(--line);border-radius:15px;display:flex;justify-content:space-between;gap:20px}
.badge{font-size:11px;padding:5px 8px;border-radius:20px;background:#eee6dd;color:#73695f}
.calendar-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px}
.calendar-head h3{font:26px Georgia,serif;margin:0}
.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.day-name{text-align:center;color:var(--muted);font-size:12px;font-weight:700;padding:8px}
.day{min-height:92px;border:1px solid var(--line);border-radius:13px;padding:9px;background:#fffdfa;cursor:pointer}
.day.today{border-color:#a98f7d}
.day .num{font-weight:700;font-size:13px}
.day .due{font-size:11px;color:#8a7162;margin-top:10px}
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px}
.stat strong{font:34px Georgia,serif;display:block;margin-bottom:5px}
.stat span{font-size:12px;color:var(--muted)}
.subject-progress{display:flex;flex-direction:column;gap:12px}
.progress-row{border:1px solid var(--line);padding:16px;border-radius:15px}
.progress-row-top{display:flex;justify-content:space-between;margin-bottom:9px;font-size:14px}
.trophies{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.trophy{min-height:240px;text-align:center;border:1px solid var(--line);border-radius:18px;padding:20px}
.trophy img{width:130px;height:130px;object-fit:contain}
.trophy.locked img{opacity:.18;filter:grayscale(1)}
.settings-stack{display:flex;flex-direction:column;gap:15px}
.file-input{display:none}
.toast{position:fixed;right:24px;bottom:24px;background:#403a35;color:#fff;padding:13px 18px;border-radius:12px;display:none;z-index:30}
.modal{position:fixed;inset:0;background:rgba(45,38,32,.35);display:none;align-items:center;justify-content:center;z-index:20;padding:20px}
.modal-box{background:var(--card);border-radius:22px;padding:32px;max-width:520px;width:100%;box-shadow:0 20px 60px rgba(40,30,20,.2)}
.modal-box h3{font:29px Georgia,serif;margin:0 0 10px}
.modal-box p{color:var(--muted);line-height:1.5}
.modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:24px}
.small{font-size:12px;color:var(--muted)}
@media(max-width:1050px){.grid,.topic-grid{grid-template-columns:repeat(2,1fr)}.stat-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){.sidebar{width:200px;min-width:200px}.main{margin-left:200px;width:calc(100% - 200px);padding:35px 22px}.grid,.topic-grid,.trophies,.review-layout{grid-template-columns:1fr}.options{grid-template-columns:1fr}.calendar-grid{gap:3px}.day{min-height:65px}}

#muteSoundsButton{
  width:40px;
  height:40px;
  padding:0;
  border:0;
  background:transparent;
  color:#9a9187;
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
}

#muteSoundsButton:hover{
  background:rgba(255,255,255,.42);
}

#muteSoundsButton:active{
  transform:scale(.94);
}

#muteIcon{
  width:20px;
  height:20px;
  fill:none;
  stroke:#9a9187;
  stroke-width:1.7;
  stroke-linecap:round;
  stroke-linejoin:round;
}

#muteIcon .speaker{
  fill:#9a9187;
  stroke:none;
}

#muteIcon .slash{
  display:none;
}

#muteSoundsButton.muted .wave{
  display:none;
}

#muteSoundsButton.muted .slash{
  display:block;
}


.add-subject-icon{
  width:34px;
  height:34px;
  border-radius:50%;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border:1px solid var(--line);
  font-size:22px;
  line-height:1;
}


/* =======================================================
   AUTH / LOGIN PAGE
======================================================= */

#loginScreen {
  position: fixed;
  inset: 0;
  z-index: 99999;
  background: #f7f3ed;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 32px;
}

.login-card {
  width: min(430px, 100%);
  background: #fffdf9;
  border: 1px solid #ded7cc;
  border-radius: 22px;
  padding: 42px 38px;
  text-align: center;
  box-shadow: 0 18px 55px rgba(60, 50, 40, .10);
}

.login-mark {
  width: 58px;
  height: 58px;
  margin: 0 auto 22px;
  border-radius: 50%;
  background: #e8e1d7;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4b443c;
  font: 26px Georgia, serif;
}

.login-card h1 {
  margin: 0;
  color: #2f2b27;
  font: 34px Georgia, serif;
}

.login-card p {
  margin: 12px 0 30px;
  color: #7d756c;
  font-size: 14px;
  line-height: 1.6;
}

.google-login-button {
  width: 100%;
  height: 50px;
  border: 1px solid #d5cec4;
  border-radius: 12px;
  background: #fff;
  color: #332f2b;
  font: 600 14px Arial, sans-serif;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  transition: .18s ease;
}

.google-login-button:hover {
  background: #f8f5f0;
  border-color: #bfb6aa;
}

.google-login-icon {
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
}

.login-status {
  min-height: 20px;
  margin-top: 16px;
  color: #8a8177;
  font-size: 12px;
}

body.authenticated #loginScreen {
  display: none;
}


