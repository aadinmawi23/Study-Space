<script id="username-system-js">
let currentUsername = null;

function updateTopUserProfile(username) {

  const usernameLabel =
    document.getElementById("accountUsernameLabel");

  const accountName =
    document.getElementById("accountName");

  const sidebarBrand =
    document.getElementById("sidebarStudySpaceBrand");

  if (!username) {
    if (usernameLabel) {
      usernameLabel.textContent = "";
      usernameLabel.classList.remove("show");
    }

    if (accountName) {
      accountName.textContent = "Account";
    }

    if (sidebarBrand) {
      const sidebarUsername =
        sidebarBrand.querySelector(".sidebar-brand-username");

      if (sidebarUsername) {
        sidebarUsername.textContent = "Flo's";
      }
    }

    return;
  }

  if (usernameLabel) {
    usernameLabel.textContent = username;
    usernameLabel.classList.add("show");
  }

  if (accountName) {
    accountName.textContent = username;
  }

  const panelName =
    document.getElementById("accountPanelName");

  if (panelName) {
    panelName.textContent = username;
  }

  if (sidebarBrand) {
    const sidebarUsername =
      sidebarBrand.querySelector(".sidebar-brand-username");

    if (sidebarUsername) {
      sidebarUsername.textContent = username + "'s";
    }
  }
}

async function loadCurrentUsername() {
  if (!supabaseClient || !supabaseSession?.user) {
    currentUsername = null;
    updateTopUserProfile(null);
    return null;
  }

  const { data, error } = await supabaseClient
    .from("profiles")
    .select("username")
    .eq("id", supabaseSession.user.id)
    .maybeSingle();

  if (error) {
    console.error("Could not load username:", error);
    return null;
  }

  currentUsername = data?.username || null;

  updateTopUserProfile(currentUsername);

  const authUsernameLabel =
    document.getElementById("authUsernameLabel");

  if (authUsernameLabel) {
    authUsernameLabel.textContent = currentUsername || "";
    authUsernameLabel.style.display =
      currentUsername ? "block" : "none";
  }

  return currentUsername;
}

function showUsernameSetup() {
  const modal = document.getElementById("usernameSetupModal");
  if (!modal) return;

  modal.classList.add("show");

  const input = document.getElementById("usernameInput");
  if (input) {
    input.value = currentUsername || "";
    setTimeout(() => input.focus(), 100);
  }
}

function hideUsernameSetup() {
  const modal = document.getElementById("usernameSetupModal");
  if (modal) modal.classList.remove("show");
}

async function saveUsername() {
  if (!supabaseClient || !supabaseSession?.user) return;

  const input = document.getElementById("usernameInput");
  const errorBox = document.getElementById("usernameError");
  const button = document.getElementById("usernameSaveBtn");

  const username = input.value.trim();

  errorBox.textContent = "";

  if (!/^[A-Za-z0-9_]{3,20}$/.test(username)) {
    errorBox.textContent =
      "Username must be 3–20 characters using only letters, numbers, or _.";
    return;
  }

  button.disabled = true;
  button.textContent = "Saving...";

  const { data: existing, error: checkError } = await supabaseClient
    .from("profiles")
    .select("id")
    .eq("username", username)
    .maybeSingle();

  if (checkError) {
    console.error(checkError);
    errorBox.textContent = "Could not check username. Please try again.";
    button.disabled = false;
    button.textContent = "Continue";
    return;
  }

  if (existing && existing.id !== supabaseSession.user.id) {
    errorBox.textContent = "That username is already taken.";
    button.disabled = false;
    button.textContent = "Continue";
    return;
  }

  const { error } = await supabaseClient
    .from("profiles")
    .upsert({
      id: supabaseSession.user.id,
      username: username,
      updated_at: new Date().toISOString()
    });

  if (error) {
    console.error(error);

    if (error.code === "23505") {
      errorBox.textContent = "That username is already taken.";
    } else {
      errorBox.textContent = "Could not save username. Please try again.";
    }

    button.disabled = false;
    button.textContent = "Continue";
    return;
  }

  currentUsername = username;
  updateTopUserProfile(currentUsername);

  const authUsernameLabel =
    document.getElementById("authUsernameLabel");

  if (authUsernameLabel) {
    authUsernameLabel.textContent = currentUsername;
    authUsernameLabel.style.display = "block";
  }

  hideUsernameSetup();

  button.disabled = false;
  button.textContent = "Continue";
}

async function ensureUsername() {
  if (!supabaseSession?.user) return;

  const username = await loadCurrentUsername();

  if (!username) {
    showUsernameSetup();
  }
}
</script>










