/* =========================================================
   SUBJECT STORAGE
   ========================================================= */

const SUBJECT_STORAGE_KEY = "floSubjects";

function cloneDefaultSubjects(){
  return DEFAULT_SUBJECT_CATALOG.map(subject => ({
    ...subject,
    topics:[...subject.topics]
  }));
}

function loadSubjects(){
  try{
    const saved = JSON.parse(
      localStorage.getItem(SUBJECT_STORAGE_KEY)
    );

    if(Array.isArray(saved) && saved.length){
      return saved;
    }
  }catch(error){
    console.warn("Could not load saved subjects.",error);
  }

  const defaults = cloneDefaultSubjects();
  localStorage.setItem(
    SUBJECT_STORAGE_KEY,
    JSON.stringify(defaults)
  );

  return defaults;
}

let SUBJECT_CATALOG = loadSubjects();

function saveSubjects(){
  localStorage.setItem(
    SUBJECT_STORAGE_KEY,
    JSON.stringify(SUBJECT_CATALOG)
