      this request to keep the page stuck.
    */
    if (supabaseClient) {

      const signOutPromise =
        supabaseClient.auth.signOut();

      await Promise.race([
        signOutPromise,
        new Promise(resolve =>
          setTimeout(resolve, 3000)
        )
      ]);

    }

