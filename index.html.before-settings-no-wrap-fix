        typeof showAuthStatusToast ===
        "function"
      ) {
        showAuthStatusToast("Signed out");
      }
    } catch {}

    /*
      Close account panels.
    */
    document
      .querySelectorAll(
        ".account-panel, .account-menu"
      )
      .forEach(panel => {
        panel.classList.remove("open");
      });

