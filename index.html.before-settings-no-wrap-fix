/* =========================================================
   ANSWER QUESTION
   ========================================================= */

function answerQuiz(choice){

  if(
    !currentQuiz ||
    currentQuiz.answered
  ){
    return;
  }

  const q =
    currentQuiz.questions[
      currentQuiz.index
    ];

  currentQuiz.answered =
    true;

  const result =
    choice === "UNKNOWN"
      ? "unknown"
      : choice === q.answer
        ? "correct"
        : "wrong";

  if(result === "correct"){
    playAppSound("correct");
  }else{
    playAppSound("wrong");
  }

  recordAnswer(
    q,
    choice,
    result
  );


  ["A","B","C","D"].forEach(
    letter=>{
      const button =
        document.getElementById(
          `opt-${letter}`
        );

      button.classList.add(
        "disabled"
      );

      button.onclick = null;
    }
  );


  if(result === "correct"){

    document
      .getElementById(
        `opt-${choice}`
      )
      .classList.add("correct");

  }
  else if(result === "wrong"){

    document
      .getElementById(
        `opt-${choice}`
      )
      .classList.add("wrong");

    document
      .getElementById(
        `opt-${q.answer}`
      )
      .classList.add("correct");

  }
  else{

    document
      .getElementById(
        `opt-${q.answer}`
      )
      .classList.add("correct");
  }


  const feedback =
    document.getElementById(
      "feedback"
    );

  feedback.innerHTML = `

    <div class="explanation">

      <strong>
        ${
          result === "correct"
            ? "Correct"
            : result === "unknown"
              ? "Not learnt"
              : "Incorrect"
        }
      </strong>

      ${
        result !== "correct"
          ? ` · Correct answer: ${q.answer}`
          : ""
      }

      ${
        q.explanation
          ? `<br>${escapeHTML(q.explanation)}`
          : ""
      }

    </div>
  `;


  document.getElementById(
    "nextArea"
  ).innerHTML = `

    <button
      class="btn"
      onclick="nextQuestion()"
    >
      ${
        currentQuiz.index <
        currentQuiz.questions.length - 1
          ? "Next Question →"
          : "Finish Quiz"
      }
    </button>
  `;
}


/* =========================================================
   NEXT QUESTION
   ========================================================= */

function nextQuestion(){

  if(
    currentQuiz.index <
    currentQuiz.questions.length - 1
  ){

    currentQuiz.index++;
    currentQuiz.answered = false;

    renderQuiz();

  }else{

    finishQuiz();
  }
}


/* =========================================================
   QUIZ RESULTS
   ========================================================= */

function finishQuiz(){

  playAppSound("complete");

  const results =
    currentQuiz.results;

  /*
   * Because performance history is
   * persistent, calculate this quiz's
   * result from the most recent answer
   * event for each question.
   */

  const questions =
    currentQuiz.questions;

  const quizResults =
    questions.map(q=>{

      const events =
        answerHistory.filter(
          event =>
            event.questionId === q.id
        );

      return events.length
        ? events[events.length - 1].result
        : null;

    }).filter(Boolean);

  const correct =
    quizResults.filter(
      result => result === "correct"
    ).length;

  const wrong =
    quizResults.filter(
      result => result === "wrong"
    ).length;

  const unknown =
    quizResults.filter(
      result => result === "unknown"
    ).length;

  const answered =
    correct + wrong + unknown;

  const accuracy =
    Math.round(
      correct /
      Math.max(1,answered) *
      100
    );


  currentQuiz = null;


  showModal(`

    <h3>
      Quiz Complete
    </h3>

    <p>
      You answered
      <strong>${answered}</strong>
      questions.
    </p>

    <div
      class="stat"
      style="margin-top:15px"
    >
      <strong>
        ${accuracy}%
      </strong>

      <span>
        Accuracy
      </span>
    </div>

    <div
      class="small"
      style="margin-top:15px"
    >
      Correct: ${correct}
      ·
      Wrong: ${wrong}
      ·
      Not learnt: ${unknown}
    </div>

    <div class="modal-actions">

      <button
        class="btn light"
        onclick="closeModal();renderSubject(selectedSubject,'topics')"
      >
        Back to Topics
      </button>

      <button
        class="btn"
        onclick="closeModal();renderProgress()"
      >
        View Progress
      </button>

    </div>
  `);
}


