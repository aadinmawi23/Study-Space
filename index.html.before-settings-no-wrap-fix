  );

  if(typeof appSounds !== "undefined"){
    Object.values(appSounds).forEach(sound=>{
      sound.muted = soundsMuted;
    });
  }
}

function toggleSoundMute(event){
  if(event) event.stopPropagation();

  soundsMuted = !soundsMuted;

  localStorage.setItem(
    SOUND_MUTED_KEY,
    String(soundsMuted)
