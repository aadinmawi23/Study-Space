/* =======================================================
   ACCOUNT — SAME ROW AS FLO'S STUDY SPACE
======================================================= */

.account-control {
  position: relative;
  margin-left: auto;
}

.account-button {
  height: 38px;
  padding: 0 13px 0 9px;
  border: 1px solid #d8d0c5;
  border-radius: 20px;
  background: #fffdf9;
  color: #403a34;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 9px;
  font: 600 13px Arial, sans-serif;
}

.account-button:hover {
  background: #f5f1eb;
}

.account-avatar {
  width: 25px;
  height: 25px;
  border-radius: 50%;
  object-fit: cover;
  display: none;
}

.account-avatar-placeholder {
  width: 25px;
  height: 25px;
  border-radius: 50%;
  background: #e8e1d7;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #514a42;
  font: 12px Georgia, serif;
}

.account-menu {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  width: 250px;
  background: #fffdf9;
  border: 1px solid #dcd4c9;
  border-radius: 15px;
  padding: 14px;
  box-shadow: 0 16px 40px rgba(60, 50, 40, .13);
  display: none;
  z-index: 1000;
}

.account-menu.open {
  display: block;
}

.account-profile {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 4px 3px 13px;
  border-bottom: 1px solid #e8e1d8;
}

.account-profile-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
}

.account-profile-placeholder {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #e8e1d7;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #514a42;
  font: 17px Georgia, serif;
}

.account-name {
  color: #332e29;
  font-weight: 600;
  font-size: 13px;
  line-height: 1.35;
}

.account-email {
  color: #8a8177;
  font-size: 11px;
  margin-top: 2px;
  word-break: break-word;
}

.account-signout {
  width: 100%;
  margin-top: 12px;
  padding: 9px 10px;
  border: 1px solid #ddd5ca;
  border-radius: 9px;
  background: #f8f5f0;
  color: #4b443c;
  cursor: pointer;
  font: 600 12px Arial, sans-serif;
}

.account-signout:hover {
  background: #eee8df;
}


.workspace-header-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16px;
}

.workspace-header-row h1,
.workspace-header-row h2 {
  margin-right: auto;
}


/* =========================================================
   LOGIN / ACCOUNT
========================================================= */

.dashboard-header-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  width:100%;
  margin-bottom:28px;
  position:relative;
  z-index:50;
}

.dashboard-title{
  min-width:0;
}

.dashboard-title .eyebrow{
  margin-bottom:8px;
}

.dashboard-title h2{
  margin:0;
}

.auth-control{
  position:relative;
  flex-shrink:0;
  z-index:100;
  pointer-events:auto;
}

.auth-icon-button{
  width:48px !important;
  height:48px !important;
  min-width:48px !important;
  min-height:48px !important;
  padding:0;
  border:0;
  border-radius:50%;
  background:transparent;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  overflow:hidden;
  position:relative;
  z-index:1000;
}


.auth-icon-button:hover{
  background:#f5f1eb;
  border-color:#c9c0b5;
}

.auth-icon-button:active{
  transform:scale(.95);
}

.auth-person-icon{
  width:46px !important;
  height:46px !important;
  min-width:46px !important;
  min-height:46px !important;
  fill:none;
  stroke:currentColor;
  stroke-width:3.5;
  stroke-linecap:round;
  stroke-linejoin:round;
  pointer-events:none;
}

.auth-avatar{
  width:30px;
  height:30px;
  border-radius:50%;
  object-fit:cover;
  pointer-events:none;
}


/* LOGIN POPUP */

.auth-popup{
  position:fixed;
  inset:0;
  z-index:99999;
  background:rgba(40,34,28,.25);
  display:none;
  align-items:center;
  justify-content:center;
  padding:24px;
}

.auth-popup.open{
